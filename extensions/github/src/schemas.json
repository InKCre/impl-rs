{
  "GitHubAccount": {
    "additionalProperties": false,
    "description": "One canonical GitHub user or organization account.",
    "properties": {
      "node_id": {
        "title": "Node Id",
        "type": "string"
      },
      "database_id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Database Id"
      },
      "kind": {
        "enum": [
          "user",
          "organization"
        ],
        "title": "Kind",
        "type": "string"
      },
      "login": {
        "title": "Login",
        "type": "string"
      },
      "name": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Name"
      },
      "url": {
        "title": "Url",
        "type": "string"
      },
      "avatar_url": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Avatar Url"
      }
    },
    "required": [
      "node_id",
      "kind",
      "login",
      "url"
    ],
    "title": "GitHubAccount",
    "type": "object"
  },
  "GitHubRepository": {
    "additionalProperties": false,
    "description": "Stable Repository identity and useful source-authored metadata.",
