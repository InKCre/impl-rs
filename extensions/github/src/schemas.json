      },
      "name_with_owner": {
        "title": "Name With Owner",
        "type": "string"
      },
      "description": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Description"
      },
      "url": {
        "title": "Url",
        "type": "string"
      },
      "homepage_url": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Homepage Url"
      },
      "primary_language": {
        "anyOf": [
          {
            "type": "string"
