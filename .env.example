# dotenv 数据；复制为 .env 并填入部署已准入的 native Peer 凭据
DATABASE_URL=postgresql://inkcre_core:replace-me@127.0.0.1:5432/inkcre
JWT_SECRET=
INKCRE_BIND=127.0.0.1:8000
INKCRE_STATE_DIR=.runtime
INKCRE_PEER_NAME=Rust Peer
INKCRE_PEER_LEASE_SECONDS=60
INKCRE_DATABASE_MAX_CONNECTIONS=10
INKCRE_REQUEST_TIMEOUT_SECONDS=30
INKCRE_WORKER_CONCURRENCY=4
# serve 默认开启 worker discovery 和 Cron；共享库中会处理本机可执行的 pending Job，
# 并为到期的共享 Cron 创建 Job。只提供 HTTP 时同时关闭以下两项：
# INKCRE_NO_WORKER=true
# INKCRE_NO_CRON=true
# 保留 worker 但不扫描共享 pending 队列：仅尽力处理本进程按 ID 提示的 Job；
# 不保证恢复重启前、其他 Peer 或自动 Cron 创建的 pending 工作。
# INKCRE_NO_WORKER_DISCOVERY=true
# 可选稳定 UUID；未指定时保存在 INKCRE_STATE_DIR/peer-id
# INKCRE_PEER_ID=
# 多个可信本地 executable manifest 用逗号分隔；HTTP 只按此清单安装精确版本
# INKCRE_EXTENSION_MANIFESTS=
# inkcre token 默认签发 3600 秒有效期的 JWT
# INKCRE_TOKEN_LIFETIME_SECONDS=3600
RUST_LOG=info
