# dotenv 数据；复制为 .env 并填入部署已准入的 native Peer 凭据
DATABASE_URL=postgresql://inkcre_core:replace-me@127.0.0.1:5432/inkcre
JWT_SECRET=
INKCRE_BIND=127.0.0.1:8000
INKCRE_STATE_DIR=.runtime
INKCRE_PEER_NAME=Rust Peer
INKCRE_PEER_LEASE_SECONDS=60
INKCRE_DATABASE_MAX_CONNECTIONS=10
INKCRE_REQUEST_TIMEOUT_SECONDS=30
# 可选稳定 UUID；未指定时保存在 INKCRE_STATE_DIR/peer-id
# INKCRE_PEER_ID=
# 多个可信本地 manifest 用逗号分隔
# INKCRE_EXTENSION_MANIFESTS=
RUST_LOG=info
